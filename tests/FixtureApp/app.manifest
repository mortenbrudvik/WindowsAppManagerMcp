<?xml version="1.0" encoding="utf-8"?>
<!--
  WamFixtureApp's manifest. It asks for version 6 of the common controls, which holds TaskDialogIndirect (the task dialog
  of the main window's Task dialog button, roadmap M3.F4), and runs as the invoker.

  No DPI setting here: Program.Main sets the process DPI awareness from the command line (dpi-awareness), and a manifest
  setting would override that call.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WamFixtureApp.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
