<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Declares per-monitor v2 DPI awareness (see the file); the SDK also copies it into the apphost exe -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!--
      No System.Drawing.Common package: on .NET 10 the Windows Desktop framework referenced below carries a newer
      System.Drawing.Common than any 9.x package, so NuGet prunes the package (NU1510) and the exe uses the framework's.
    -->
    <!--
      The UI Automation 3 (COM) client for the default UI Automation engine (Native/Uia3Tree, roadmap M3.2): a
      prebuilt, MIT-licensed interop assembly of UIAutomationClient.idl, one managed dll with no native code that the
      single-file publish bundles into the exe. A COMReference would need tlbimp, which dotnet build cannot run.
    -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>

  <!-- Sample layout presets, seeded into the layouts folder on first use (see LayoutStorageOptions) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\config\layouts\*.json" LogicalName="WindowsAppManagerMcp.SampleLayouts.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- UI Automation framework references for browser reading -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

</Project>
